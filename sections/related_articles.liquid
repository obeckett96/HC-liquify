<h1 class="heading-style-h2 text-colour-dark">
{{ section.settings.text_related_heading }}
</h1>
        <div class="spacer-small"></div>
        <div class="container-max">
          <div class="blog_cms-wrapper w-dyn-list">
            <div li-for:inside="article in blog.articles limit: 3" role="list" class="blog_list w-dyn-items">
        {% for article in blog.articles limit: 3 %}                            
              
                            {% if article.title != currentArticle %}    <div li-if="article.title != currentArticle" role="listitem" class="blog_cms-item w-dyn-item">
    
                <a li-object:href="article.url" href="{{ article.url }}" class="blog_item-grid w-inline-block">
                  <div id="w-node-_2c70579c-a50c-391e-dd47-706a953e61e9-953e61e8" class="blog_tags-wrapper">
                    <div class="blog_tag-row">
                      {% for tag in article.tags %}    <div li-for="tag in article.tags" class="blog_tag">
                                    
                        
                            <div li-object="tag">{{ tag }}</div>
                            
                      
                        </div>
{% endfor %}
                    </div><img class="img_blog" src="{{ article.image | image_url: width: 450 }}" alt="{{ article.image.alt }}" sizes="(max-width: 1571px) 100vw, 1571px" li-object:src="article.image | image_url: width: 450" loading="lazy" li-object:alt="article.image.alt" srcset="{{ 'Rectangle-15_1Rectangle-15.avif' | asset_url }} 500w, {{ 'Rectangle-15_1Rectangle-15.avif' | asset_url }} 800w, {{ 'Rectangle-15_1.avif' | asset_url }} 1571w">
                  </div>
                  <div class="blog_info-wrapper">
                    <h3 li-object="article.title" class="blog-title">{{ article.title }}</h3>
                    <div li-object="article.excerpt" class="blog-subhead">{{ article.excerpt }}</div>
                  </div>
                </a>
                  </div>
{% endif %}
                            
            
                    {% endfor %}    </div>
            {% if blog.articles == blank %}    <div li-if="blog.articles == blank" class="blog_cms-empty w-dyn-empty">
    
              <div>There's nothing here yet...</div>
              <div class="empty-subhead">Come back soon! We'll be updating the blog.</div>
                </div>
{% endif %}
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Related Articles",
    "class": "section",
    "settings": [
        {
            "id": "text_related_heading",
            "type": "text",
            "label": "Related Heading",
            "default": "Related Articles"
        }
    ],
    "presets": [
        {
            "name": "Related Articles",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "article"
        ]
    }
} {% endschema %}