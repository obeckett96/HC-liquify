<div class="container-max">
          <div class="hero_content">
            <h1 no-flicker="true" word-split="true" class="heading-style-h1">Nurture your roots.<br>Activate your growth.</h1>
            <div data-w-id="729619e4-82cb-2afd-f32d-39fc948e436e" class="home_product-intro">
              <div class="contain_product-intro-img">{% if section.settings.image_left_image %}
{{ section.settings.image_left_image | image_url: width: 1000 | image_tag: class: 'img_product-intro left', sizes: '(max-width: 1500px) 100vw, 1500px', loading: 'lazy' }}
{% else %}
<img class="img_product-intro left" src="{{ 'shampoo-whip-png_1.avif' | asset_url }}" alt="" sizes="(max-width: 1500px) 100vw, 1500px" loading="lazy" srcset="{{ 'shampoo-whip-png_1shampoo-whip-png.avif' | asset_url }} 500w, {{ 'shampoo-whip-png_1.avif' | asset_url }} 1500w">
{% endif %}
