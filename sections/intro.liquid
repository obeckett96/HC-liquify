<div class="container-max">
          <div class="hero_content">
            <h1 no-flicker="true" word-split="true" class="heading-style-h1">Nurture your roots.<br>Activate your growth.</h1>
            <div data-w-id="729619e4-82cb-2afd-f32d-39fc948e436e" class="home_product-intro">
              <div class="contain_product-intro-img">{% if section.settings.image_left_image %}
{{ section.settings.image_left_image | image_url: width: 1000 | image_tag: class: 'img_product-intro left', sizes: '(max-width: 1274px) 100vw, 1274px', loading: 'lazy' }}
{% else %}
<img class="img_product-intro left" src="{{ 'shampoo-01-1.png' | asset_url }}" alt="" sizes="(max-width: 1274px) 100vw, 1274px" loading="lazy" srcset="{{ 'shampoo-01-1-p-500.png' | asset_url }} 500w, {{ 'shampoo-01-1-p-800.png' | asset_url }} 800w, {{ 'shampoo-01-1.png' | asset_url }} 1274w">
{% endif %}
                <a button-slide="true" no-flicker="true" href="{{ section.settings.url_intro_btn_1 }}" class="button pink w-button"> {{ section.settings.text_intro_btn_1 }} </a>
              </div>
              <div class="contain_product-intro-img">{% if section.settings.image_right_image %}
{{ section.settings.image_right_image | image_url: width: 1000 | image_tag: class: 'img_product-intro right', sizes: '(max-width: 1274px) 100vw, 1274px', loading: 'lazy' }}
{% else %}
<img class="img_product-intro right" src="{{ 'condo-1.png' | asset_url }}" alt="" sizes="(max-width: 1274px) 100vw, 1274px" loading="lazy" srcset="{{ 'condo-1-p-500.png' | asset_url }} 500w, {{ 'condo-1-p-800.png' | asset_url }} 800w, {{ 'condo-1.png' | asset_url }} 1274w">
{% endif %}
                <a button-slide="true" no-flicker="true" href="{{ section.settings.url_intro_btn_2 }}" class="button pink w-button"> {{ section.settings.text_intro_btn_2 }} </a>
              </div>
            </div>
          </div>
          <div class="bg-gradient-light"></div>
        </div>
        <div class="container-max">
          <div class="spacer-xxxl"></div>
          <div class="grid-benefits">
            <div class="benefit_circle">
              <div class="text-benefit">
{{ section.settings.text_benefit_1 }}
</div>
              <div class="grad-cover"></div>
            </div>
            <div class="benefit_circle stim">
              <div class="text-benefit">
{{ section.settings.text_benefit_2 }}
</div>
              <div class="grad-cover"></div>
            </div>
            <div class="benefit_circle seal">
              <div class="text-benefit">
{{ section.settings.text_benefit_3 }}
</div>
              <div class="grad-cover"></div>
            </div>
          </div>
        </div> {% schema %} {
