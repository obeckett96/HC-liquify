<div class="container-max">
          <div class="block-content about-bio">
            <div button-slide="true" prevent-flicker="true" class="img_about-bio">{% if section.settings.image_founder_1_image %}
{{ section.settings.image_founder_1_image | image_url: width: 1000 | image_tag: class: 'img-inner-standard', sizes: '100vw', loading: 'lazy' }}
{% else %}
<img class="img-inner-standard" src="{{ 'DSC01426_1.avif' | asset_url }}" alt="" sizes="100vw" loading="lazy" srcset="{{ 'DSC01426_1DSC01426.avif' | asset_url }} 500w, {{ 'DSC01426_1.avif' | asset_url }} 1107w">
{% endif %}</div>
            <div class="about-block-right">
              <h3 word-split="true" prevent-flicker="true" class="subheading-standard">
{{ section.settings.text_founder_1_heading }}
</h3>
              <p word-split="true" prevent-flicker="true" class="pg smaller">
{{ section.settings.text_founder_1_pg }}
</p>
              <a button-slide="true" prevent-flicker="true" href="{{ section.settings.url_founder_1_url }}" class="ig-link-about"> {{ section.settings.text_founder_1_handle }} </a>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Meet Tuscany",
    "class": "section about",
    "settings": [
        {
            "id": "image_founder_1_image",
            "type": "image_picker",
            "label": "founder 1 image"
        },
        {
            "id": "text_founder_1_heading",
            "type": "text",
            "label": "Founder 1 heading",
            "default": "Meet tuscany"
        },
        {
            "id": "text_founder_1_pg",
            "type": "text",
            "label": "founder 1 pg",
            "default": "New Zealand entrepreneur, beauty, fashion and Sports enthusiast Tuscany Hamel was inspired to create a range of products that provide benefits to peoples overall health of there hair, mind and body.Where it all started, was after Tuscany having a very successful early start of her career as a professional tennis player playing on the junior world circuit. But unfortunately, after a fews years of back to back injuries made her having to change course. Growing up with two very successful Hair salon\/stylists ownersTo stay updated on all things Tuscany and sneak peeks to Hair Candy go check her Instagram out here:<br\/>"
        },
        {
            "id": "text_founder_1_handle",
            "type": "text",
            "label": "founder 1 handle",
            "default": "@tuscanyhamel"
        },
        {
            "id": "url_founder_1_url",
            "type": "url",
            "label": "founder 1 URL"
        }
    ],
    "presets": [
        {
            "name": "Meet Tuscany",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}