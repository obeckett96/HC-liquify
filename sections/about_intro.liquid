<div class="container-max">
          <div class="block-content">
            <div>
              <div button-slide="true" prevent-flicker="true" class="eyebrow-text">
{{ section.settings.text_eyebrow_text_intro }}
</div>
              <h1 prevent-flicker="true" word-split="true" class="heading-style-h1 smaller">
{{ section.settings.text_intro_heading }}
</h1>
            </div>
            <div class="pg-wrap">
              <div word-split="true" prevent-flicker="true" class="text-color-secondary w-richtext"> {{ section.settings.textarea_intro_paragraphs }} </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "About Intro",
    "class": "section about",
    "settings": [
        {
            "id": "text_eyebrow_text_intro",
            "type": "text",
            "label": "eyebrow text intro",
            "default": "THE\u00a0HAIRCANDY\u00a0STORY"
        },
        {
            "id": "text_intro_heading",
            "type": "text",
            "label": "intro heading",
            "default": "Born out of genuine love for hair"
        },
        {
            "id": "textarea_intro_paragraphs",
            "type": "textarea",
            "label": "intro paragraphs",
            "default": "\n                <p>Hair Candy all began from a small concept of, how we care for you and your hair. With over 15 years of experience and research combined, Our beautiful product was born.<\/p>\n                <p>\u200d<\/p>\n                <p>Hair Candy was born out of genuine love for hair and maximising hair health. A passion that overflowed from a hairstylist's love for hair and creating Natural products which are care for you and the environment.<\/p>\n                <p>\u200d<\/p"
        }
    ],
    "presets": [
        {
            "name": "About Intro",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}