{%- comment -%}
  ---- Replace current form area with this block ----
  This is server-rendered (Liquid). It will show the Add to cart + subscription options without requiring Alpine/Vue.
  Backup file first.
{%- endcomment -%}

{% form 'product', product, class: 'product-header_default-state' %}

  {%- comment -%} SELLING PLANS (server-rendered fallback) {%- endcomment -%}
  {% if product.selling_plan_groups.size > 0 %}
    <div class="product-header_subscription" aria-live="polite">
      <div>
        <label class="product-header_subscription_radio-lable">
          <input type="radio" name="selling_plan_choice" value="" checked>
          {{ section.settings.text_without_subscription | default: 'One-time purchase' }}
        </label>
      </div>

      {%- comment -%}
        Render plan allocations grouped per variant.
        We render one container per variant and hide all but the selected variant's container.
        JS will toggle visibility when variant changes and copy the selected radio into name="selling_plan".
      {%- endcomment -%}
      {% for variant in product.variants %}
        <div class="variant-selling-plans" data-variant-id="{{ variant.id }}" style="{% unless variant == product.selected_or_first_available_variant %}display:none{% endunless %}">
          {% for allocation in variant.selling_plan_allocations %}
            <label class="product-header_subscription_radio-lable-small">
              <input
                type="radio"
                name="selling_plan_for_{{ variant.id }}"
                value="{{ allocation.selling_plan.id }}"
                class="selling-plan-radio"
                data-selling-plan-for="{{ variant.id }}"
              >
              {{ allocation.selling_plan.name }}
            </label>
          {% endfor %}
        </div>
      {% endfor %}

      {%- comment -%} Hidden canonical field that Shopify expects: name="selling_plan" {%- endcomment -%}
      <input type="hidden" name="selling_plan" value="" class="selling-plan-hidden" />
    </div>
  {% endif %}

  {%- comment -%} ADD TO CART area {%- endcomment -%}
  <div class="product-header_add-to-cart-wrapper">
    {% if product.available %}
      {% if product.variants.size > 1 %}
        <label>
          <span class="visually-hidden">Choose variant</span>
          <select name="id" class="product-variant-select" aria-label="Variant">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-variant-id="{{ variant.id }}"
              >
                {{ variant.title }}{% unless variant.available %} — sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        </label>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endif %}

      <label>
        <span class="visually-hidden">Quantity</span>
        <input type="number" name="quantity" value="1" min="1" class="form_input-2 is-quantity" />
      </label>

      <button type="submit" class="button pink add-to-cart">Add to cart</button>
    {% else %}
      <button type="button" class="button-2 is-secondary max-width-full pointer-events-off" disabled>Out of Stock</button>
    {% endif %}
  </div>

{% endform %}
