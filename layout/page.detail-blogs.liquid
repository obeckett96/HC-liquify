  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
  <!--  GSAP ANIMATIONS  -->
  <script>
// WORD REVEAL TEXT - GLOBAL
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("[word-split='true']").forEach((text) => {
    const split = SplitText.create(text, {
      type: "words, chars",
      mask: "words",
      wordsClass: "word",
      charsClass: "char",
    });
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: text,
        start: "top bottom",
        end: "top 90%",
        toggleActions: "none play none reset",
      },
    });
    tl.from(split.words, {
      yPercent: 120,
      delay: 0.2,
      duration: 0.8,
      stagger: { amount: 0.5 },
    });
    gsap.set(text, { visibility: "visible" });
  });
});
//BUTTON GLOBAL ANIMATION
// Button reveal animation on scroll - optimized for multiple sections
gsap.registerPlugin(ScrollTrigger);
// Set initial state for all buttons with data-button-reveal='true'
gsap.set("[button-slide='true']", {
  opacity: 0,
  y: 30, // slide up from 30px below
  visibility: "visible", // prevent flicker
});
// Use ScrollTrigger.batch for multiple buttons across different sections
ScrollTrigger.batch("[button-slide='true']", {
  onEnter: (elements) =>
    gsap.to(elements, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power2.out",
      stagger: 0.1,
    }),
  onEnterBack: (elements) =>
    gsap.to(elements, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power2.out",
      stagger: 0.1,
    }),
  start: "top 80%", // animation starts when element is 80% down the viewport
  // markers: true // uncomment for debugging
});
</script>
  <script>
// GSAP loader + init (only loads GSAP if not present)
(function () {
  function init() {
    const nodes = document.querySelectorAll('[data="loop-images"]');
    if (!nodes.length) return;
    nodes.forEach((el) => {
      // Ensure initial state (solid) in case CSS was missing/overridden
      gsap.set(el, { y: '1rem' });
      // Timeline per element (infinite loop)
      const tl = gsap.timeline({ repeat: -1 });
      tl.to(el, { y: '0rem', duration: 0.8, ease: 'power1.inOut' })
        .to(el, { y: '1rem', duration: 0.7, ease: 'power1.out' })
        .to(el, { y: '1rem', duration: 0.7 }); // hold at 1rem
      // If you prefer a staggered group animation, replace the above per-element loop
      // with a single timeline operating on all nodes and add .to(nodes, {..., stagger: 0.1})
    });
  }
  if (typeof gsap === 'undefined') {
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js';
    s.onload = init;
    document.head.appendChild(s);
  } else {
    init();
  }
})();
</script>
  <!--  LENIS SMOOTH SCROLL -->
  <link rel="stylesheet" href="https://unpkg.com/lenis@1.2.3/dist/lenis.css">
  <script src="https://unpkg.com/lenis@1.2.3/dist/lenis.min.js"></script>
  <script>
let lenis = new Lenis({
  lerp: 0.1,
  wheelMultiplier: 0.7,
  gestureOrientation: "vertical",
  normalizeWheel: false,
  smoothTouch: false,
});
function raf(time) {
  lenis.raf(time);
  requestAnimationFrame(raf);
}
requestAnimationFrame(raf);
$("[data-lenis-start]").on("click", function () {
  lenis.start();
});
$("[data-lenis-stop]").on("click", function () {
  lenis.stop();
});
$("[data-lenis-toggle]").on("click", function () {
  $(this).toggleClass("stop-scroll");
  if ($(this).hasClass("stop-scroll")) {
    lenis.stop();
  } else {
    lenis.start();
  }
});
</script>
